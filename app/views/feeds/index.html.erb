<h1>Feeds</h1>

<% if @feeds.any? %>
  <table class="feed-table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Filter</th>
        <th>Link</th>
      </tr>
    </thead>
    <tbody>
        <% @feeds.each do |feed| %>
          <tr>
            <td><%= link_to display_episode_title(feed.name), feed_path(feed) %></td>
          <td>
            <span class="muted">
              <% if feed.episode_filters.any? || feed.segment_filters.any? %>
                <%= [
                  ("Episode #{filter_summary(feed.episode_filters)}" if feed.episode_filters.any?),
                  ("Segment #{filter_summary(feed.segment_filters)}" if feed.segment_filters.any?)
                ].compact.join(' / ') %>
              <% else %>
                No filters
              <% end %>
            </span>
          </td>
          <td><%= link_to 'RSS', public_rss_feed_url(feed), target: '_blank', rel: 'noopener' %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No feeds yet.</p>
<% end %>
