<%= form_with(model: feed, class: 'feed-form') do |form| %>
  <div class="form-actions">
    <%= form.submit(feed.persisted? ? 'Save' : 'Create feed', name: 'commit', class: 'button-primary') %>
    <%= form.submit('Preview', name: 'commit', class: 'button-secondary') %>
  </div>

  <% if feed.errors.any? %>
    <div class="form-errors">
      <h3><%= pluralize(feed.errors.count, 'error') %> prevented this feed from being saved:</h3>
      <ul>
        <% feed.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-field">
    <%= form.label :name, class: 'form-label' %>
    <%= form.text_field :name, required: true, class: 'form-input' %>
  </div>

  <%= form.hidden_field :show_external_id %>

  <div class="form-field">
    <%= form.label :max_episodes, 'Max episodes', class: 'form-label' %>
    <%= form.number_field :max_episodes,
                          required: true,
                          min: 1,
                          max: Feed::MAX_MAX_EPISODES,
                          step: 1,
                          class: 'form-input' %>
    <small>Sync and include up to <%= Feed::MAX_MAX_EPISODES %> latest episodes.</small>
  </div>

  <div class="form-field">
    <label class="checkbox-label">
      <%= form.check_box :exclude_replays %>
      Exclude replays from RSS and downloads
    </label>
  </div>

  <%= render 'filter_rows', rows: @episode_filter_rows, kind: 'episode', title: 'Episode filters',
                            hint: 'Include/exclude episodes by matching their title or description.' %>

  <%= render 'filter_rows', rows: @segment_filter_rows, kind: 'segment', title: 'Segment filters',
                            hint: 'For segment-based shows, include/exclude stitched segments by matching their title.' %>

  <div class="form-actions">
    <%= form.submit(feed.persisted? ? 'Save' : 'Create feed', name: 'commit', class: 'button-primary') %>
    <%= form.submit('Preview', name: 'commit', class: 'button-secondary') %>
  </div>
<% end %>

<%= render 'filter_preview' if @preview_episodes.present? %>
